# Optional PostgreSQL connection for Optuna. Copy this file to .env.
CODES_OPTUNA_STORAGE_URL=postgresql+psycopg2://DB_USER@DB_HOST:5432/DB_NAME
PGPASSWORD='DB_PASSWORD'

# To use a passfile, remove PGPASSWORD and set this instead.
# PGPASSFILE="${HOME}/.pgpass-codes"

# Set these if required by your PostgreSQL provider.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/absolute/path/to/ca.pem
